+    def _nvfp4_weight_only_input_scales(self) -> set[str]:
+        """Local NVFP4 patch: a W4A16 (weight-only) checkpoint has no activation
+        scales; the Marlin path retires these parameters after loading."""
+        from vllm.model_executor.layers.quantization.modelopt import (
+            ModelOptNvFp4FusedMoE,
+        )
+
+        names: set[str] = set()
+        for name, module in self.named_modules():
+            method = getattr(module, "quant_method", None)
+            if not (isinstance(method, ModelOptNvFp4FusedMoE) and method.use_a16):
+                continue
+            for leaf in ("w13_input_scale", "w2_input_scale"):
+                param = getattr(module, leaf, None)
+                if param is not None:
+                    param.data.fill_(1.0)
+                    names.add(f"{name}.{leaf}")
+        return names
+
